<%- layout('/layouts/boilerplate') %>

    <div class="row">
        <div class="col-8 offset-2">
            <h3>Create New Post</h3>
            <form action="/listing/new" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="title" class="form-control" placeholder="Enter Title of Post" required></input>

                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="description" class="form-control" placeholder="Enter Title of Post"
                        required></textarea>
                </div>
                <!-- <div class="mb-3">
                    <label for="image" class="form-label">Image</label>
                    <input name="image" class="form-control" placeholder="Enter Image-url"></input>
                </div> -->
                
                <div class="mb-3">
                    <label for="image" class="form-label">Upload Image</label>
                    <input type="file" name="image" class="form-control"></input>

                </div>

                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="price" type="number" class="form-control"
                            placeholder="Enter Title of price"></input>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="Country" class="form-label">Country</label>
                        <input name="country" class="form-control" placeholder="Enter Title of country"
                            required></input>
                    </div>

                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <textarea name="location" class="form-control" placeholder="Enter Title of location"
                        required></textarea>
                </div>

                <br>
                <button class="btn btn-dark">Add</button>
                <br><br><br>
            </form>
        </div>
    </div>